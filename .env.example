# ── Tracking & Analytics ──────────────────────────────
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Google Ads conversion label (format: AW-XXXXX/YYYYY)
# Used as the 'send_to' value for conversion events
NEXT_PUBLIC_GA_CONVERSION_SEND_TO=AW-XXXXXXXXXX/YYYYYYYYY

# Google Ads conversion ID for phone/WhatsApp tap clicks (low-value engagement).
# MUST be a dedicated conversion action ID (not the lead-form ID) — format AW-XXX/YYY.
# If unset, phone/WhatsApp taps send NO conversion to Google Ads (they no longer
# fall back to the £50 lead-form action). Create the action in Google Ads →
# Tools → Conversions, then set its ID here and in Vercel.
NEXT_PUBLIC_GADS_CLICK_CONV_ID=AW-XXXXXXXXXX/YYYYYYYYY

# Google Ads API (server-side, OAuth). Used ONLY by scripts/ (audit-*, add-*,
# toggle-* and the ghl-webhook offline-conversion uploads) — never the browser,
# so these are NOT NEXT_PUBLIC.
# Re-auth when a script reports 'invalid_grant' (refresh token revoked/expired):
#   1. Google Cloud Console → APIs & Services → Credentials → OAuth client
#      ("Desktop" type) with scope https://www.googleapis.com/auth/adwords.
#   2. Mint a fresh token via the consent flow, then paste it here / in Vercel.
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxxxx
GOOGLE_ADS_CUSTOMER_ID=8479028400

# Meta (Facebook) Pixel
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXX

# ── Supabase (Database) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Email (contact forms via Gmail SMTP + Nodemailer) ──
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
# Do not use your normal Gmail password.
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=your.address@gmail.com
EMAIL_TO=upgraderoofs@yahoo.com

# Optional: if you switch the API routes to Resend instead of Nodemailer
# RESEND_API_KEY=re_XXXXXXXXXX

# ── GoHighLevel (CRM / lead pipeline) ────────────────
# Create a Private Integration token in GoHighLevel:
#   Settings → Integrations → Private Integrations → Add.
# The token is location-scoped, so use the location id for this account.
GHL_API_KEY=pit-xxxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Custom field IDs on the above GHL location (12-20 char ids). Each maps a lead
# value to the matching custom field in GHL. Create the fields first, then paste
# their ids. If a field id is missing, that value is simply skipped (no crash).
GHL_CF_GCLID=xxxxxxxxxxxxxxx
GHL_CF_POSTCODE=xxxxxxxxxxxxxxx
GHL_CF_SERVICE_TYPE=xxxxxxxxxxxxxxx
GHL_CF_ROOF_TYPE=xxxxxxxxxxxxxxx
GHL_CF_SERVICE_NEEDED=xxxxxxxxxxxxxxx

# Speed-to-lead workflow: an inbound lead immediately enqueues a same-day
# callback workflow (trigger name matches /site visit booked/ pattern in the
# webhook). If unset, the webhook logs "not set" and skips the speed-to-lead
# trigger — leads still land, just without the instant-callback race.
GHL_SPEED_TO_LEAD_WORKFLOW_ID=

# Voice-AI workflow: after a lead wins a job, optionally hand off to a voice AI
# agent via a GHL 'Workflow' message. Unused unless a voice AI agent is set up.
# If unset, job-won leads are logged but no voice AI workflow is fired.
GHL_VOICE_AI_WORKFLOW_ID=

# Shared secret for the GHL webhook endpoint (/api/ghl-webhook). Set the SAME
# value in Vercel AND in the GHL workflow webhook (Zapier/Integromat header
# "x-ghl-secret" or body "secret", or the ?secret= query param). If left empty
# the endpoint is open (unauthenticated) — set it in production.
GHL_WEBHOOK_SECRET=

# ── Optional: Google Maps ────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Google Business Profile API (GBP) — used by scripts/audit-gbp-live.js ──
# Reads locations/reviews via the legacy OAuth2 refresh-token flow (scope:
# https://www.googleapis.com/auth/business.manage). Install the same vars in
# Vercel if you run these audits there.
#
# Re-auth when a script reports 'invalid_grant':
#   1. Google Cloud Console → APIs & Services → Credentials → OAuth client
#      ("Desktop") with scope https://www.googleapis.com/auth/business.manage.
#   2. Run the OAuth consent flow to mint a fresh refresh token, then paste it
#      here and in Vercel. Note: service-account key 'google-service-account.json'
#      is a SEPARATE path (Performance API/GSC/GA4 in audit-gbp.js,
#      check-system-status.js, audit-executive-report.js) and invalid_grant there
#      means the key was deleted/regenerated — download a fresh one into the repo root.
GBP_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GBP_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GBP_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Instant Indexing API (service-account key) ──
# Re-crawls a few key URLs via urlNotifications:publish so changes get re-indexed
# fast. Uses google-service-account.json in the repo root (same key as GSC/GA4),
# authenticated with the EXTRA scope https://www.googleapis.com/auth/indexing.
# To enable: 1) turn on the "Indexing API" for the Cloud project; 2) verify the
# domain in Search Console and add the service-account email as an owner;
# 3) confirm the domain passes Google's posting-volume gate. Sites below that gate
# (common for small local businesses) get "Requested entity was not found" even
# when everything is wired correctly — verify with:
#   node scripts/check-indexing-api.js          # read-only eligibility check
#   node scripts/check-indexing-api.js <url>    # request a re-index of <url>
# Optional override for the key path if you host it elsewhere:
# SA_FILE=google-service-account.json
